# Optional environment variables. You can use the local Settings UI instead.
# This file is documentation; it is not auto-loaded. Never put real keys in HTML.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Browser-visible READ-ONLY token restricted to required assets and localhost:
CESIUM_ION_TOKEN=
CESIUM_TILES_ASSET_ID=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Optional private config/cache directory, outside the application folder:
JARVIS_DATA_DIR=
